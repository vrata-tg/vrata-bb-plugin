{
  "name": "@vrata-ai/bb-plugin",
  "version": "0.1.3",
  "type": "module",
  "imports": {
    "#vrata-pi-runtime": "./packaging/pi/runtime.js"
  },
  "description": "Врата AI provider for bb with an embedded Pi agent runtime",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vrata-tg/vrata-bb-plugin.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "bb": ">=0.41",
    "bbPluginSdk": ">=0.4.34",
    "node": ">=22.19.0"
  },
  "bb": {
    "name": "Врата AI",
    "description": "Pi coding agent with Врата AI models. The first thread asks for your API key.",
    "branding": {
      "icon": "./media/vrata.svg"
    },
    "server": "./src/server.ts",
    "app": "./src/app.tsx",
    "host": "./src/host.ts"
  },
  "scripts": {
    "build": "node scripts/vendor-pi-runtime.mjs && bb plugin build",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.tests.json && node scripts/bundle-test-runtime.mjs && node --test --test-concurrency=1 tests/*.test.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@get-bb/plugin-sdk": "0.4.34",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "esbuild": "0.28.1",
    "jsdom": "^26.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.7.0"
  },
  "files": [
    "dist/*.js",
    "dist/*.css",
    "dist/*.meta.json",
    "src/",
    "packaging/pi/LICENSE",
    "packaging/pi/NOTICE.md",
    "media/"
  ]
}
